# ══════════════════════════════════════════════════════════════
#                    IZALITH TRADING SYSTEM
# ══════════════════════════════════════════════════════════════

# ══════════ GENERAL ══════════
DRY_RUN=true
LOG_LEVEL=INFO

# Modules to activate (comma-separated): signals,dca,grid,scalper,dashboard
ACTIVE_MODULES=signals,dashboard

# ══════════ CRYPTO (Binance) ══════════
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true

# ══════════ FOREX (OANDA) ══════════
OANDA_ACCOUNT_ID=
OANDA_API_KEY=
OANDA_PRACTICE=true

# ══════════ STOCKS (Alpaca) ══════════
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ══════════ MODULE: SIGNALS ══════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Signal types (comma-separated): rsi,macd,breakout,volume_spike,bollinger
SIGNAL_TYPES=rsi,macd,breakout,volume_spike

# ══════════ MODULE: DCA ══════════
DCA_ENABLED_ASSETS=BTC/USDT,ETH/USDT,VOO
DCA_AMOUNT_USD=50
DCA_FREQUENCY=weekly
# Options: hourly, daily, weekly, biweekly, monthly
DCA_DAY_OF_WEEK=monday
# Only for weekly/biweekly
DCA_HOUR=9

# ══════════ MODULE: GRID ══════════
GRID_ENABLED_ASSETS=USDT/USDC
GRID_TOTAL_INVESTMENT=1000
GRID_LEVELS=10
GRID_RANGE_LOW=0.995
GRID_RANGE_HIGH=1.005

# ══════════ MODULE: SCALPER ══════════
SCALPER_ENABLED_ASSETS=BTC/USDT,ETH/USDT,EUR_USD,GBP_USD
SCALPER_STRATEGIES=momentum,mean_reversion
SCALPER_MAX_POSITION_USD=500
SCALPER_PROFIT_TARGET_PCT=0.5
SCALPER_STOP_LOSS_PCT=0.3
SCALPER_MAX_DAILY_TRADES=20
SCALPER_MAX_DAILY_LOSS_USD=100

# ══════════ MODULE: DASHBOARD ══════════
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0
