# ══════════════════════════════════════════════════════════════
#                    IZALITH TRADING SYSTEM
# ══════════════════════════════════════════════════════════════
# Copia este archivo a .env. Nunca subas el .env a git.

# ══════════ GENERAL ══════════
# true = todo en papel con precios reales. Déjalo así al menos un mes.
DRY_RUN=true
LOG_LEVEL=INFO
# El "día" de los límites diarios (pérdida máxima, operaciones por día)
TRADING_TIMEZONE=America/Mexico_City
# Capital de papel cuando DRY_RUN=true
PAPER_CASH_USD=10000
# Precios inventados si una fuente real falla. Sólo para desarrollo; con dinero real se ignora.
ALLOW_SIMULATION=false
# Freno de emergencia: si la cuenta cae más que esto desde su máximo, no se abren posiciones nuevas
# (cerrar sí se puede). Se quita a mano con: python -m tools.freno --quitar
MAX_DRAWDOWN_PCT=25

# Módulos: signals, dca, grid, scalper, allocator, collectors, dashboard
ACTIVE_MODULES=allocator,collectors,signals,reports,dashboard

# ══════════ CRIPTO ══════════
# binance (México), kraken (Canadá), bitso (pesos), bybit, okx...
CRYPTO_EXCHANGE=binance
# Llaves SOLO con permiso de operar, nunca de retirar
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true

# ══════════ FOREX (OANDA) ══════════
# Ojo: desde México OANDA no da su API (sí desde Canadá). Ver la pestaña "Dónde abrir cuenta".
OANDA_ACCOUNT_ID=
OANDA_API_KEY=
OANDA_PRACTICE=true

# ══════════ ACCIONES ══════════
# auto = Alpaca si hay llaves; si no, precios de Yahoo sólo para papel. ibkr = Interactive Brokers.
STOCKS_BROKER=auto
# IBKR necesita TWS o IB Gateway abierto con la API habilitada.
# IB Gateway: 4002 = papel, 4001 = real. TWS: 7497 = papel, 7496 = real.
# Mejor práctica: DRY_RUN=false con el puerto de PAPEL; las órdenes van al motor de papel de IBKR.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17

# ══════════ ACCIONES (Alpaca) ══════════
# Sin llaves, en papel se usan precios de Yahoo (con unos minutos de retraso).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ══════════ ALLOCATOR: estrategias del laboratorio en vivo ══════════
# Claves del catálogo (python -m lab.review las evalúa). Sólo estrategias de portafolio sin perpetuos:
#   etf_60_40, cash_plus_btc, faber_trend, dual_momentum, rsi2_spy, trend_btc, trend_voltarget, xs_momentum
ALLOCATOR_STRATEGIES=trend_voltarget,faber_trend,cash_plus_btc
# Capital para CADA estrategia
ALLOCATOR_CAPITAL_USD=1000
ALLOCATOR_CHECK_MINUTES=30
# En cripto, órdenes límite que esperan en el libro (Kraken: 0.40% en vez de 0.80%). Si no se llenan
# en 15 minutos, el resto va a mercado.
ALLOCATOR_PASSIVE_ORDERS=true

# ══════════ RECOLECTORES (mercados poco vigilados) ══════════
COLLECTORS_INTERVAL_MINUTES=15
# Opcional: token gratis de banxico.org.mx/SieAPIRest para ver la tasa de Banxico en los termómetros
BANXICO_TOKEN=

# ══════════ REPORTES Y ALARMAS (módulo reports) ══════════
# Resumen diario por Telegram a esta hora (en TRADING_TIMEZONE). Usa TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID.
REPORT_HOUR=21
# Crea un "check" gratis en healthchecks.io y pega aquí su URL: si el bot deja de latir, te llega un correo.
HEALTHCHECK_URL=

# ══════════ MODULE: SIGNALS ══════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# rsi,macd,breakout,volume_spike,bollinger
SIGNAL_TYPES=rsi,macd,breakout,volume_spike

# ══════════ MODULE: DCA ══════════
DCA_ENABLED_ASSETS=BTC/USDT,ETH/USDT,VOO
DCA_AMOUNT_USD=50
# hourly, daily, weekly, biweekly, monthly (cualquier otra cosa detiene el módulo con un error)
DCA_FREQUENCY=weekly
DCA_DAY_OF_WEEK=monday
# Hora en TRADING_TIMEZONE
DCA_HOUR=9

# ══════════ MODULE: GRID ══════════
# El escalón (rango / niveles) tiene que ser mayor que 2 comisiones + spread, o el módulo no arranca.
# En USDC/USDT casi nunca lo es con comisión de 0.1%: este módulo es para pares que sí se mueven.
GRID_ENABLED_ASSETS=USDC/USDT
GRID_TOTAL_INVESTMENT=1000
GRID_LEVELS=4
GRID_RANGE_LOW=0.995
GRID_RANGE_HIGH=1.005
GRID_FEE_PCT=0.1

# ══════════ MODULE: SCALPER ══════════
# En el laboratorio las tres estrategias del scalper salen en rojo. Sólo para papel.
SCALPER_ENABLED_ASSETS=BTC/USDT,ETH/USDT
SCALPER_STRATEGIES=momentum,mean_reversion
SCALPER_MAX_POSITION_USD=500
SCALPER_PROFIT_TARGET_PCT=0.5
SCALPER_STOP_LOSS_PCT=0.3
SCALPER_MAX_DAILY_TRADES=20
SCALPER_MAX_DAILY_LOSS_USD=100

# ══════════ MODULE: DASHBOARD ══════════
DASHBOARD_PORT=8765
# 127.0.0.1 = sólo esta computadora. 0.0.0.0 lo abre a toda la red: entonces pon un token.
DASHBOARD_HOST=127.0.0.1
# Si lo defines, abre el panel una vez con http://127.0.0.1:8765/#token=TU_TOKEN
DASHBOARD_TOKEN=
